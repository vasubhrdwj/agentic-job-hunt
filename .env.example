GOOGLE_API_KEY=your-ai-studio-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Drafting model — Gemini 3 per the hackathon brief. The judge stays on
# gemini-2.5-flash (hard-coded) for score comparability across swaps.
GEMINI_DRAFT_MODEL=gemini-3.5-flash
# Optional hybrid opportunity fit. When disabled or unavailable, scans and Today
# stay fully usable through the deterministic scorer.
ENABLE_LLM_FIT_EVALUATION=0
GEMINI_FIT_MODEL=gemini-3.5-flash
GEMINI_FIT_TIMEOUT_MS=12000
PHOENIX_API_KEY=pk-your-phoenix-key
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space-name
PHOENIX_QUERY_TRANSPORT=rest
PHOENIX_QUERY_LOOKBACK_HOURS=24
PHOENIX_QUERY_TIMEOUT_S=12
PHOENIX_QUERY_SPAN_LIMIT=1000
SERPAPI_API_KEY=your-serpapi-key
# Bound new contact-discovery plans by UTC calendar windows. Replays and an
# already-running plan do not consume another slot.
JOB_HUNT_CONTACT_PLAN_OWNER_DAILY_LIMIT=2
JOB_HUNT_CONTACT_PLAN_GLOBAL_DAILY_LIMIT=5
JOB_HUNT_CONTACT_PLAN_GLOBAL_MONTHLY_LIMIT=80
# Required by local Docker Compose. Generate a URL-safe value, for example with
# `openssl rand -hex 24`, and keep the real value only in your untracked .env.
POSTGRES_PASSWORD=
# Durable practical-product database. Compose builds its internal URL from
# POSTGRES_PASSWORD. For host-run tools, set this to the same URL-safe password;
# hosted web and worker processes must share one TLS-enabled managed Postgres.
DATABASE_URL=postgresql+psycopg://job_hunt:${POSTGRES_PASSWORD}@localhost:5432/job_hunt
# Legacy-only development compatibility. Practical mode never reads or writes
# this SQLite file; leave unset unless explicitly running with practical mode 0.
# JOB_HUNT_DB_PATH=outcomes.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
ENVIRONMENT=development
# Practical mode protects provider-consuming hunts with the owner session.
# Set to 0 only while exercising the legacy public demo compatibility path.
ENABLE_PRACTICAL_MODE=1
# Keep the compatibility API read-only while completed history is imported.
# Production additionally requires LEGACY_HUNT_DEPRECATION_URL to use HTTPS.
LEGACY_HUNT_API_MODE=read_only
LEGACY_HUNT_API_SUNSET=Tue, 31 Dec 2030 23:59:59 GMT
LEGACY_HUNT_DEPRECATION_URL=https://github.com/vasubhrdwj/agentic-job-hunt/blob/main/docs/runbooks/legacy-hunt-deprecation.md
ENABLE_TRACING=0
ENABLE_TRACE_DRAFT_CONTENT=0
GEMINI_PAID_SERVICE_ACK=0
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
JOB_HUNT_DATA_KEYS=
# Legacy-only dead-letter requeue credential. Practical requeue is owner-scoped.
# JOB_HUNT_OPERATOR_TOKEN_HASH=
# Account registration is explicit. Use `open` for a small multi-user beta or
# `closed` when only existing accounts should be able to sign in.
JOB_HUNT_SIGNUP_MODE=open
# Stable 32+ character HMAC key for payload-free deletion receipts. Required in
# production so owner-login rotation cannot change deletion identity.
JOB_HUNT_PRIVACY_RECEIPT_SECRET=
JOB_HUNT_SESSION_TTL_DAYS=30
JOB_HUNT_SESSION_COOKIE=job_hunt_session
JOB_HUNT_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90
JOB_HUNT_WORKER_ID=local-worker
# Comma-separated durable job capabilities. Omit the variable to preserve the
# full local worker; an explicitly blank value is rejected. Hosted free-tier
# web intentionally uses scan_saved_search only.
JOB_HUNT_WORKER_KINDS=legacy_hunt,scan_saved_search,discover_contacts,evaluate_opportunity_fit
# Free-tier option: run a scan-only durable worker inside the web process.
# Leave disabled when a separate worker service is running.
ENABLE_EMBEDDED_SCAN_WORKER=0
JOB_HUNT_EMBEDDED_WORKER_ID=local-embedded-scan
USE_MOCKS=0

# Production notes (see render.yaml):
# - Set ENVIRONMENT=production, ENABLE_PRACTICAL_MODE=1, and ENABLE_TRACING=1.
# - Set GEMINI_PAID_SERVICE_ACK=1 only after confirming the API key uses paid
#   Gemini quota. Free/unpaid quota must not process resumes.
# - Set JOB_HUNT_DATA_KEYS to key-id:Fernet-key. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print('v1:' + Fernet.generate_key().decode())"
# - Keep ENABLE_TRACE_DRAFT_CONTENT=0. Prompts and completions are redacted.
# - Set DATABASE_URL to managed Postgres shared by web and worker, with
#   `sslmode=require` (or the stronger verify-ca/verify-full). The
#   practical-product path rejects SQLite in production.
# - Set JOB_HUNT_PRIVACY_RECEIPT_SECRET to a separate stable random secret so
#   deletion idempotency and keyed auth throttling survive credential changes.
# - Set ALLOWED_ORIGINS to the exact HTTPS production Vercel origin, without a
#   trailing slash, path, query, or fragment.
# - Back up before deploys and follow docs/runbooks/deploy-rollback.md.
