GOOGLE_API_KEY=your-ai-studio-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
PHOENIX_API_KEY=pk-your-phoenix-key
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space-name
PHOENIX_QUERY_TRANSPORT=rest
PHOENIX_QUERY_LOOKBACK_HOURS=24
PHOENIX_QUERY_TIMEOUT_S=8
SERPAPI_API_KEY=your-serpapi-key
JOB_HUNT_DB_PATH=outcomes.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
ENVIRONMENT=development
ENABLE_TRACING=0
USE_MOCKS=0

# Production notes (Render free tier — see render.yaml):
# - Set ENVIRONMENT=production and ENABLE_TRACING=1.
# - Render free has no persistent disk: JOB_HUNT_DB_PATH=/tmp/outcomes.db
#   (absolute path required; wiped on redeploy/restart/spin-down — a /health
#   keep-alive ping prevents the spin-down case).
# - Set ALLOWED_ORIGINS to the single production Vercel URL.
