{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.tests.json && node --test .next/frontend-tests/tests/*.test.js",
    "api:export": "../.venv/bin/python ../scripts/export_openapi.py",
    "api:generate": "openapi-typescript openapi/job-hunt.openapi.json -o lib/api-generated.ts",
    "api:check": "../.venv/bin/python ../scripts/export_openapi.py --check && node scripts/check-api-artifacts.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.16"
    }
  }
}
