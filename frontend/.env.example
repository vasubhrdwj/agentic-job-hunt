# Server-only upstream used by app/api/[...path]/route.ts.
API_BASE_URL=http://127.0.0.1:8000
# One 32+ character value shared by Vercel and Render. Vercel automatically
# sends it to /api/internal/cadence and the route forwards it only after a
# constant-time check. It is never exposed to browser JavaScript.
CRON_SECRET=
JOB_HUNT_SESSION_COOKIE=job_hunt_session
# Server-side proxy safety limits. Defaults shown below.
API_PROXY_MAX_REQUEST_BYTES=524288
API_PROXY_MAX_RESPONSE_BYTES=8388608
API_PROXY_TIMEOUT_MS=20000
